# Copier ce fichier en .env (gitignoré) et adapter les valeurs.
# Priorité : variables d'environnement > .env > défauts de emusf/config.py

# Connexion PostgreSQL (schémas utilisés : test = espace de travail, data = export Salesforce)
EMUSF_DSN=host=127.0.0.1 port=6002 user=postgres password=CHANGEZ_MOI dbname=biup

# Projet SFDX local (métadonnées objets + classes Apex)
EMUSF_SFDX_OBJECTS=/chemin/vers/force-app/main/default/objects
EMUSF_SF_CLASSES=/chemin/vers/force-app/main/default/classes
